// HTML template with dark theme CSS and syntax highlighting
static const char *HTML_TEMPLATE = 
"<!DOCTYPE html>\n"
"<html>\n"
"<head>\n"
"<meta charset='UTF-8'>\n"
"<style>\n"
"    :root {\n"
"        /* Base Variables (Overridden by JS) */\n"
"        --bg-color: #292c37;\n" // Default to transparent so GTK bg shows through
"        --text-color: #ffffff;\n"
"        --code-bg: #1e1e1e;\n"
"        \n"
"        /* Modern UI Pallete */\n"
"        --font-stack: 'Segoe UI', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n"
"        --mono-font: 'JetBrains Mono', 'Fira Code', monospace;\n"
"        --border-radius: 6px;\n"
"        \n"
"        --msg-user-bg: rgba(59, 130, 246, 0.12); /* Light blue tint */\n"
"        --msg-user-text: var(--text-color);      /* Default to main text color */\n"
"        --msg-user-border: #3b82f6; /* Blue Accent */\n"
"        --msg-ai-bg: rgba(16, 185, 129, 0.12); /* Light green tint */\n"
"        --msg-ai-text: var(--text-color);      /* Default to main text color */\n"
"        --msg-ai-border: #10b981;   /* Green Accent */\n"
"        \n"
"        /* Tables */\n"
"        --table-border: #444;\n"
"        --th-bg: rgba(128, 128, 128, 0.1);\n"
"    }\n"
"\n"
"    body {\n"
"        background: var(--bg-color);\n"
"        color: var(--text-color);\n"
"        font-family: var(--font-stack);\n"
"        padding: 16px;\n"
"        margin: 0;\n"
"        font-size: 14px;\n"
"        line-height: 1.6;\n"
"    }\n"
"\n"
"    /* Messages */\n"
"    .message {\n"
"        margin-bottom: 16px;\n"
"        padding: 12px 16px;\n"
"        border-left: 3px solid transparent; /* Default no border */\n"
"        border-radius: 12px;\n"
"        animation: fadeIn 0.3s ease;\n"
"    }\n"
"    .user {\n"
"        background: var(--msg-user-bg);\n"
